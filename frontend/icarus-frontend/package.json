    "@angular/router": "^22.1.5",
    "@lucide/angular": "^1.31.0",
    "@weeehaoooz/talos-calendar": "^0.1.1",
    "@weeehaoooz/talos-ui": "^0.1.1",
    "date-fns": "^4.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
